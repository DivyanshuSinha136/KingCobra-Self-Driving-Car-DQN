// Training end to end (tiny run): artefacts, reproducibility, the shared network in the loop, evaluation sanity.
import std.system;
import std.io;
import std.json;
import "../src/config.kc" as config;
import "../src/trainer.kc" as trainer;
import "../src/world.kc" as world;
import "../src/features.kc" as features;
import "../src/agent.kc" as agent;
import "../src/car.kc" as car;
import "../src/track.kc" as track;

fn tiny(dir: string) -> object {
    let c = config.defaults();
    c["train"]["episodes"] = 4;
    c["train"]["eval_every"] = 2;
    c["train"]["eval_starts"] = 1;
    c["train"]["final_eval_starts"] = 1;
    c["train"]["log_every"] = 2;
    c["train"]["out_dir"] = dir;
    c["train"]["name"] = "tiny";
    c["tracks"]["train"] = [1, 2];
    c["tracks"]["val"] = [51];
    c["tracks"]["test"] = [101];
    c["sim"]["cars"] = 2;
    c["sim"]["eval_cars"] = 2;
    c["sim"]["max_steps"] = 120;
    c["replay"]["batch"] = 8;
    c["replay"]["capacity"] = 256;
    c["replay"]["warmup"] = 16;
    c["agent"]["hidden"] = [8];
    config.validate(c);
    return c;
}

fn test_training_writes_artefacts() {
    let dir = system.make_temp_dir("kc_drive_train_");
    defer system.rmdir(dir, true);
    let res = trainer.train(tiny(dir), false);
    let p = trainer.paths(tiny(dir));
    assert(io.exists(p["model"]) && io.exists(p["card"]) && io.exists(p["metrics"]));
    let card = json.parse(io.read_file(p["card"]));
    assert_eq(card["input_dim"], 22);
    assert_eq(card["network"], [22, 8, 12]);
    assert_eq(len(card["actions"]), 12);
    assert_eq(card["config"]["train"]["out_dir"], "models");
    assert(card["eval_unseen"]["runs"] >= 2);
    let m = json.parse(io.read_file(p["metrics"]));
    assert_eq(len(m["history"]), 2);
}

fn test_same_seed_same_result() {
    let d1 = system.make_temp_dir("kc_drive_a_");
    let d2 = system.make_temp_dir("kc_drive_b_");
    defer system.rmdir(d1, true);
    defer system.rmdir(d2, true);
    let a = trainer.train(tiny(d1), false);
    let b = trainer.train(tiny(d2), false);
    assert_eq(a["card"]["total_steps"], b["card"]["total_steps"]);
    assert_eq(a["history"][0]["loss"], b["history"][0]["loss"]);
    assert_eq(io.read_file(trainer.paths(tiny(d1))["model"]), io.read_file(trainer.paths(tiny(d2))["model"]));
}

fn test_choose_all_is_one_batched_pass_over_the_running_cars() {
    let cfg = tiny("/tmp");
    let ag = agent.create(features.DIM, car.N_ACTIONS, cfg["agent"]);
    let w = world.new_world(track.generate(1, 5.0, 60.0), 4, 0, 8.0);
    w["cars"][2]["done"] = true;
    let acts = trainer.choose_all(ag, w);
    assert_eq(len(acts), 4);
    assert_eq(acts[2], 4);                                   // finished cars get a placeholder
    for (i in [0, 1, 3]) {
        assert_eq(acts[i], agent.act_greedy(ag, features.encode(w["cars"][i])));   // observation i -> action i
    }
}

fn test_n_step_window_emits_discounted_return() {
    let rb = { S: [], A: [], R: [], S2: [], D: [], G: [], count: 0, capacity: 10, head: 0, prioritized: false };
    let w = [[[0.0], 0, 1.0, [1.0], 0], [[1.0], 1, 2.0, [2.0], 0], [[2.0], 2, 3.0, [3.0], 1]];
    trainer.emit(rb, w, 0, 0.5);
    assert_eq(rb["R"][0], 2.75);
    assert_eq(rb["G"][0], 0.125);
    assert_eq(rb["D"][0], 1);
    trainer.emit(rb, w, 2, 0.5);
    assert_eq(rb["R"][1], 3.0);
    assert_eq(rb["G"][1], 0.5);
}

fn test_evaluate_reports_consistent_numbers() {
    let cfg = tiny("/tmp");
    let ag = agent.create(features.DIM, car.N_ACTIONS, cfg["agent"]);
    let tracks = trainer.make_tracks(cfg, [1, 2]);
    let r = trainer.evaluate(ag, cfg, tracks, 1);
    assert_eq(r["runs"], 4);                                 // 2 tracks x 1 start x 2 cars
    let o = r["outcomes"];
    assert_eq(o["lap"] + o["wrecked"] + o["stuck"] + o["timeout"], 4);
    assert(r["mean_progress"] >= 0.0 && r["mean_progress"] <= 1.0);
    assert(r["drift_share"] >= 0.0 && r["drift_share"] <= 1.0);
}

fn test_baseline_drives_a_lap() {
    let cfg = config.defaults();
    cfg["sim"]["eval_cars"] = 1;
    let r = trainer.evaluate({ baseline: true }, cfg, trainer.make_tracks(cfg, [1]), 1);
    assert_eq(r["completion"], 1.0);
}
